# Anthropic
ANTHROPIC_API_KEY=
CONTEXT_MODEL=claude-haiku-4-5-20251001
ANSWER_MODEL=claude-sonnet-5
# Standard answers are concise by default. The 900-token path is selected only
# for explicitly detailed, urgent, migration, architecture, or incident requests.
ANSWER_MAX_TOKENS=400
ANSWER_TARGET_WORDS=200
ANSWER_EXTENDED_MAX_TOKENS=900
ANSWER_EXTENDED_TARGET_WORDS=360
# Used only when the output gate flags an ambiguous evidence-backed answer.
OUTPUT_GUARD_JUDGE_MODEL=claude-haiku-4-5-20251001
OUTPUT_GUARD_JUDGE_MAX_TOKENS=48
# Anthropic prompt caching marks stable system/tool/history prefixes. It is not response caching.
PROMPT_CACHING_ENABLED=true

# Langfuse (leave blank to disable tracing locally)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
